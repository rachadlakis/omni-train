# Copy to .env in your project root (next to dist_kit/) and fill in.

# Required for gated HF models (LLaMA, Mistral, Gemma). Leave empty for open models.
HF_TOKEN=hf_your_token_here

# Optional NCCL overrides — setup_dist_process_group auto-detects NVLink and
# sets NCCL_P2P_DISABLE accordingly; set it here only to force a value.
# NCCL_P2P_DISABLE=1

# Optional: path to the YAML config, same schema as OMNI-Train's config.yaml.
# Default resolution: ./config.yaml (project root), then dist_kit/config.yaml.
# DIST_CONFIG=config.yaml
